# Auto detect text files and perform auto normalization
* text=auto

# Source code - use auto line endings
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.css text
*.scss text
*.md text
*.mdx text

# Configuration files - use auto line endings
.gitignore text
.gitattributes text
.copilotignore text
.prettierrc text
.prettierignore text
.eslintrc* text
tsconfig*.json text
package.json text
package-lock.json text
yarn.lock text
pnpm-lock.yaml text

# Shell scripts - always LF (for cross-platform compatibility)
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pdf binary
