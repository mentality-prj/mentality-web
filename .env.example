#Next
NEXT_PUBLIC_BASE_URL=http://localhost:3000

#AI Backend (Nest)
NEXT_PUBLIC_API_URL=http://localhost:3200/api

#Cypress
CYPRESS_BASE_URL=http://localhost:3000

#Auth
# AUTH_SECRET - used by NextAuth.js to sign and encrypt JWT tokens on the frontend
AUTH_SECRET="secret"

# NEXT_PUBLIC_JWT_SECRET - shared secret with backend for validating backend-issued JWTs
# This should match the JWT_SECRET on your NestJS backend
NEXT_PUBLIC_JWT_SECRET="your-backend-jwt-secret"

#Google
AUTH_GOOGLE_ID="secret"
AUTH_GOOGLE_SECRET="secret"
GOOGLE_REFRESH_TOKEN="secret"

#Nova Poshta
NOVA_POSHTA_API_KEY="your-nova-poshta-api-key"
